# Portable stdlib extensions must be built into libpython for Switch.
*static*
array arraymodule.c
math mathmodule.c _math.c -DPy_BUILD_CORE_MODULE
cmath cmathmodule.c _math.c -DPy_BUILD_CORE_MODULE
_contextvars _contextvarsmodule.c
_struct _struct.c
_random _randommodule.c -DPy_BUILD_CORE_MODULE
_pickle _pickle.c
_datetime _datetimemodule.c
_bisect _bisectmodule.c
_heapq _heapqmodule.c
_json -I$(srcdir)/Include/internal -DPy_BUILD_CORE_BUILTIN _json.c
_statistics _statisticsmodule.c
unicodedata unicodedata.c
_csv _csv.c
_opcode _opcode.c
_md5 md5module.c
_sha1 sha1module.c
_sha256 sha256module.c -DPy_BUILD_CORE_BUILTIN
_sha512 sha512module.c -DPy_BUILD_CORE_BUILTIN
binascii binascii.c
zlib zlibmodule.c -lz
