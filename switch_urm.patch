--- a/renpy/common/00keymap.rpy
+++ b/renpy/common/00keymap.rpy
@@ -550,1 +550,38 @@
     return
+
+# The mod checks for updates during init by starting a Python thread. Its
+# updater is optional and cannot replace an RPA inside read-only RomFS.
+init 998 python:
+    if renpy.switch:
+        _switch_urm_mod = getattr(renpy.store, "x52URM", None)
+        if _switch_urm_mod is not None and hasattr(_switch_urm_mod, "API"):
+            def _switch_urm_skip_update(*args, **kwargs):
+                return None
+            _switch_urm_mod.API.fetchUpdate = _switch_urm_skip_update
+
+# Optional 0x52 Universal Ren'Py Mod shortcut for Switch controllers.
+# The mod already opens with Alt+M; emit that key only when the archive loaded.
+init 1000 python:
+    if renpy.switch:
+        _switch_urm_previous_map = config.map_pad_event
+        _switch_urm_held = set()
+
+        def _switch_urm_map_pad_event(name):
+            if name.endswith("_press"):
+                _switch_urm_held.add(name[:-6])
+            elif name.endswith("_release"):
+                _switch_urm_held.discard(name[:-8])
+
+            # SDL's Switch mapping reports physical X as pad_y.
+            if (name == "pad_y_press" and
+                    "pad_leftshoulder" in _switch_urm_held and
+                    "pad_rightshoulder" in _switch_urm_held and
+                    hasattr(getattr(renpy.store, "x52URM", None), "Open")):
+                return ["alt_K_m"]
+
+            if _switch_urm_previous_map is not None:
+                return _switch_urm_previous_map(name)
+
+            return config.pad_bindings.get(name, ())
+
+        config.map_pad_event = _switch_urm_map_pad_event
